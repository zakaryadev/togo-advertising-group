# Aloqa formasidagi so'rovlar shu Telegram bot orqali sizga yuboriladi.
#
# 1) Telegramda @BotFather'ga yozing -> /newbot -> nom bering -> u sizga token beradi.
#    TELEGRAM_BOT_TOKEN shu tokenga teng (masalan: 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
#
# 2) Yangi botingizga Telegram'da istalgan xabar yozing (masalan "salom"),
#    keyin brauzerda shu manzilni oching: https://api.telegram.org/bot<TOKEN>/getUpdates
#    Javobdagi "chat":{"id": ... } qiymati TELEGRAM_CHAT_ID bo'ladi.
#
# Ikkalasini ham to'ldirmaguningizcha, Aloqa sahifasidagi forma xatolik ko'rsatadi.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase (Project Settings -> API bo'limidan oling: https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panelga kirish uchun ruxsat etilgan yagona email (Supabase Auth'da
# shu email bilan foydalanuvchi yaratilgan bo'lishi kerak). Bu qiymatsiz
# /admin butunlay ishlamaydi — har bir so'rov 503 "sozlanmagan" xatosini beradi.
ADMIN_EMAIL=
