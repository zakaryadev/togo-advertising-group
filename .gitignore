# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temporary upload and processing folders
/new-images/
new-images/
new-images/temp/

# agent & IDE caches
.claude/
.agents/
.gemini/

# hidden legacy supabase & HTML dumps
.old_supabase_code/
.old_supabase_code
supabase/
deploy/
/telegram/
!.public/img/telegram/
*.html
!public/**/*.html
